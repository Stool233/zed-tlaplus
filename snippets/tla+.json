{
  "TLA+ module": {
    "prefix": "module",
    "body": ["---------------- MODULE ${1:ModuleName} ----------------", "EXTENDS ${2:Naturals}", "", "$0", "========================================================="],
    "description": "Module skeleton; use the .tla filename as the module name"
  },
  "TLA+ specification": {
    "prefix": "specification",
    "body": ["---------------- MODULE ${1:Counter} ----------------", "EXTENDS Naturals", "", "CONSTANT Max", "VARIABLE x", "", "vars == <<x>>", "ASSUME Max \\in Nat", "", "Init == x = 0", "", "Next ==", "    /\\ x < Max", "    /\\ x' = x + 1", "", "Spec == Init /\\ [][Next]_vars", "TypeOK == x \\in 0..Max", "", "$0", "======================================================="],
    "description": "State-machine specification with Init, Next, Spec, and a type invariant"
  },
  "Extend modules": {
    "prefix": "EXTENDS",
    "body": "EXTENDS ${1:Naturals, Sequences, FiniteSets}$0",
    "description": "Import standard modules"
  },
  "Declare constants": {
    "prefix": "CONSTANTS",
    "body": "CONSTANTS ${1:N}$0",
    "description": "Declare constant parameters"
  },
  "Declare variables": {
    "prefix": "VARIABLES",
    "body": "VARIABLES ${1:x, y}$0",
    "description": "Declare state variables"
  },
  "Assumption": {
    "prefix": "ASSUME",
    "body": "ASSUME ${1:N} \\in ${2:Nat}$0",
    "description": "Assumption about constants"
  },
  "Recursive operator declaration": {
    "prefix": "RECURSIVE",
    "body": "RECURSIVE ${1:Op}(_)$0",
    "description": "Declare a recursive operator before its definition"
  },
  "Operator definition": {
    "prefix": "operator",
    "body": ["${1:Op}(${2:x}) ==", "    ${3:x}", "$0"],
    "description": "Define an operator with parameters"
  },
  "Function definition": {
    "prefix": "function",
    "body": "${1:f}[${2:x} \\in ${3:S}] == ${4:x}$0",
    "description": "Define a function over a domain"
  },
  "Local operator": {
    "prefix": "LOCAL",
    "body": "LOCAL ${1:Op} == ${2:TRUE}$0",
    "description": "Definition visible only in the current module"
  },
  "Module instance": {
    "prefix": "INSTANCE",
    "body": "${1:Inst} == INSTANCE ${2:ModuleName} WITH ${3:parameter} <- ${4:value}$0",
    "description": "Instantiate a module with parameter substitutions"
  },
  "Initial predicate": {
    "prefix": "Init",
    "body": ["Init ==", "    ${1:x} = ${2:0}", "$0"],
    "description": "Initial-state predicate"
  },
  "Next action": {
    "prefix": "Next",
    "body": ["Next ==", "    /\\ ${1:guard}", "    /\\ ${2:x}' = ${3:x + 1}", "$0"],
    "description": "Next-state action with a guard and a primed variable"
  },
  "Behavior specification": {
    "prefix": "Spec",
    "body": "Spec == ${1:Init} /\\ [][${2:Next}]_${3:vars}$0",
    "description": "Behavior specification allowing stuttering steps"
  },
  "Type invariant": {
    "prefix": "TypeOK",
    "body": ["TypeOK ==", "    ${1:x} \\in ${2:Nat}", "$0"],
    "description": "Type invariant"
  },
  "Theorem": {
    "prefix": "THEOREM",
    "body": "THEOREM ${1:Safety} == ${2:Spec} => []${3:TypeOK}$0",
    "description": "Declare a theorem; add its proof separately"
  },
  "Lemma": {
    "prefix": "LEMMA",
    "body": ["LEMMA ${1:Name} == ${2:TRUE}", "PROOF", "    OBVIOUS", "$0"],
    "description": "Lemma with a simple proof skeleton"
  },
  "If expression": {
    "prefix": "IF",
    "body": "IF ${1:condition} THEN ${2:yes} ELSE ${3:no}$0",
    "description": "Conditional expression; both branches are required"
  },
  "Case expression": {
    "prefix": "CASE",
    "body": ["CASE ${1:condition} -> ${2:value}", "  [] OTHER -> ${3:defaultValue}$0"],
    "description": "Case expression with a default branch"
  },
  "Let expression": {
    "prefix": "LET",
    "body": ["LET ${1:Local} == ${2:value}", "IN ${3:Local}$0"],
    "description": "Local definitions followed by an expression"
  },
  "Universal quantifier": {
    "prefix": "forall",
    "body": "\\A ${1:x} \\in ${2:S} : ${3:P(x)}$0",
    "description": "Universal quantification over a set"
  },
  "Existential quantifier": {
    "prefix": "exists",
    "body": "\\E ${1:x} \\in ${2:S} : ${3:P(x)}$0",
    "description": "Existential quantification over a set"
  },
  "Choose expression": {
    "prefix": "CHOOSE",
    "body": "CHOOSE ${1:x} \\in ${2:S} : ${3:P(x)}$0",
    "description": "Choose an element satisfying a predicate"
  },
  "Set filter": {
    "prefix": "setfilter",
    "body": "{${1:x} \\in ${2:S} : ${3:P(x)}}$0",
    "description": "Subset containing the elements satisfying a predicate"
  },
  "Set mapping": {
    "prefix": "setmap",
    "body": "{${1:f(x)} : ${2:x} \\in ${3:S}}$0",
    "description": "Set of values obtained by mapping an expression over a set"
  },
  "Function literal": {
    "prefix": "fn",
    "body": "[${1:x} \\in ${2:S} |-> ${3:x}]$0",
    "description": "Construct a function over a domain"
  },
  "Function set": {
    "prefix": "functionset",
    "body": "[${1:S} -> ${2:T}]$0",
    "description": "Set of all functions from S to T"
  },
  "Record literal": {
    "prefix": "record",
    "body": "[${1:field} |-> ${2:value}]$0",
    "description": "Record value"
  },
  "Record set": {
    "prefix": "recordset",
    "body": "[${1:field} : ${2:Nat}]$0",
    "description": "Set of records with fields in the specified sets"
  },
  "Function update": {
    "prefix": "EXCEPT",
    "body": "[${1:f} EXCEPT ![${2:key}] = ${3:@ + 1}]$0",
    "description": "Update a function; @ denotes the previous value at that position"
  },
  "Tuple": {
    "prefix": "tuple",
    "body": "<<${1:x}, ${2:y}>>$0",
    "description": "Tuple or finite sequence"
  },
  "Unchanged variables": {
    "prefix": "UNCHANGED",
    "body": "UNCHANGED <<${1:x, y}>>$0",
    "description": "Variables whose values remain unchanged in an action"
  },
  "Enabled action": {
    "prefix": "ENABLED",
    "body": "ENABLED ${1:Action}$0",
    "description": "A next state exists that satisfies the action"
  },
  "Always": {
    "prefix": "always",
    "body": "[](${1:P})$0",
    "description": "Temporal always: P holds at every step"
  },
  "Eventually": {
    "prefix": "eventually",
    "body": "<>(${1:P})$0",
    "description": "Temporal eventually: P holds at some future step"
  },
  "Leads to": {
    "prefix": "leadsto",
    "body": "${1:P} ~> ${2:Q}$0",
    "description": "Whenever P holds, Q eventually holds"
  },
  "Weak fairness": {
    "prefix": "WF",
    "body": "WF_${1:vars}(${2:Action})$0",
    "description": "An action cannot remain continuously enabled without occurring"
  },
  "Strong fairness": {
    "prefix": "SF",
    "body": "SF_${1:vars}(${2:Action})$0",
    "description": "An action enabled infinitely often must occur infinitely often"
  },
  "Set membership": {
    "prefix": "in",
    "body": "${1:x} \\in ${2:S}$0",
    "description": "Set membership"
  },
  "Not in set": {
    "prefix": "notin",
    "body": "${1:x} \\notin ${2:S}$0",
    "description": "Non-membership in a set"
  },
  "Subset relation": {
    "prefix": "subseteq",
    "body": "${1:S} \\subseteq ${2:T}$0",
    "description": "Subset relation"
  },
  "Set union": {
    "prefix": "cup",
    "body": "${1:S} \\cup ${2:T}$0",
    "description": "Union of two sets"
  },
  "Set intersection": {
    "prefix": "cap",
    "body": "${1:S} \\cap ${2:T}$0",
    "description": "Intersection of two sets"
  },
  "Set difference": {
    "prefix": "difference",
    "body": "${1:S} \\\\ ${2:T}$0",
    "description": "Elements in S that are not in T"
  },
  "Cartesian product": {
    "prefix": "times",
    "body": "${1:S} \\X ${2:T}$0",
    "description": "Cartesian product of two sets"
  },
  "Power set": {
    "prefix": "SUBSET",
    "body": "SUBSET ${1:S}$0",
    "description": "Set of all subsets of S"
  },
  "Union of sets": {
    "prefix": "UNION",
    "body": "UNION ${1:Sets}$0",
    "description": "Union of every set in a family of sets"
  },
  "Function domain": {
    "prefix": "DOMAIN",
    "body": "DOMAIN ${1:f}$0",
    "description": "Domain of a function or record"
  },
  "Conjunction": {
    "prefix": "and",
    "body": "${1:P} /\\ ${2:Q}$0",
    "description": "Logical conjunction"
  },
  "Disjunction": {
    "prefix": "or",
    "body": "${1:P} \\/ ${2:Q}$0",
    "description": "Logical disjunction"
  },
  "Implication": {
    "prefix": "implies",
    "body": "${1:P} => ${2:Q}$0",
    "description": "Logical implication"
  },
  "Equivalence": {
    "prefix": "equiv",
    "body": "${1:P} <=> ${2:Q}$0",
    "description": "Logical equivalence"
  },
  "Sequences of a set": {
    "prefix": "Seq",
    "body": "Seq(${1:S})$0",
    "description": "All finite sequences with elements from S; requires EXTENDS Sequences"
  },
  "Sequence length": {
    "prefix": "Len",
    "body": "Len(${1:seq})$0",
    "description": "Sequence length; requires EXTENDS Sequences"
  },
  "Append to sequence": {
    "prefix": "Append",
    "body": "Append(${1:seq}, ${2:value})$0",
    "description": "Append an element to a sequence; requires EXTENDS Sequences"
  },
  "Sequence head": {
    "prefix": "Head",
    "body": "Head(${1:seq})$0",
    "description": "First element of a nonempty sequence; requires EXTENDS Sequences"
  },
  "Sequence tail": {
    "prefix": "Tail",
    "body": "Tail(${1:seq})$0",
    "description": "Remove the first element of a nonempty sequence; requires EXTENDS Sequences"
  },
  "Subsequence": {
    "prefix": "SubSeq",
    "body": "SubSeq(${1:seq}, ${2:first}, ${3:last})$0",
    "description": "Subsequence with inclusive, 1-based bounds; requires EXTENDS Sequences"
  },
  "Concatenate sequences": {
    "prefix": "concat",
    "body": "${1:left} \\o ${2:right}$0",
    "description": "Concatenate two sequences; requires EXTENDS Sequences"
  },
  "Set cardinality": {
    "prefix": "Cardinality",
    "body": "Cardinality(${1:S})$0",
    "description": "Number of elements in a finite set; requires EXTENDS FiniteSets"
  },
  "Finite set predicate": {
    "prefix": "IsFiniteSet",
    "body": "IsFiniteSet(${1:S})$0",
    "description": "Whether a set is finite; requires EXTENDS FiniteSets"
  },
  "PlusCal algorithm": {
    "prefix": "algorithm",
    "body": ["(* --algorithm ${1:AlgorithmName}", "variables ${2:x} = ${3:0};", "begin", "    ${4:Start}:", "        ${5:skip;}", "end algorithm; *)", "$0"],
    "description": "PlusCal p-syntax algorithm inside a TLA+ module"
  },
  "PlusCal concurrent algorithm": {
    "prefix": "pcalprocess",
    "body": ["(* --algorithm ${1:Workers}", "variables ${2:x} = ${3:0};", "process ${4:Worker} \\in ${5:1..2}", "begin", "    ${6:Start}:", "        ${7:skip;}", "end process;", "end algorithm; *)", "$0"],
    "description": "PlusCal p-syntax concurrent-process template"
  },
  "PlusCal while loop": {
    "prefix": "pcalwhile",
    "body": ["while ${1:condition} do", "    ${2:skip;}", "end while;$0"],
    "description": "PlusCal p-syntax loop for use inside an algorithm"
  },
  "PlusCal if statement": {
    "prefix": "pcalif",
    "body": ["if ${1:condition} then", "    ${2:skip;}", "else", "    ${3:skip;}", "end if;$0"],
    "description": "PlusCal p-syntax conditional for use inside an algorithm"
  },
  "PlusCal await": {
    "prefix": "await",
    "body": "await ${1:condition};$0",
    "description": "PlusCal: wait until a condition holds"
  },
  "PlusCal assertion": {
    "prefix": "assert",
    "body": "assert ${1:condition};$0",
    "description": "PlusCal: assertion"
  },
  "PlusCal assignment": {
    "prefix": "assign",
    "body": "${1:x} := ${2:value};$0",
    "description": "PlusCal: variable assignment"
  }
}
